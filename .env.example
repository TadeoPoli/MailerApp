# Copiá este archivo como .env y completá los valores de tu entorno local.
SECRET_KEY=
FLASK_DATABASE_HOST=127.0.0.1
FLASK_DATABASE_PORT=3306
FLASK_DATABASE_USER=
FLASK_DATABASE_PASSWORD=
FLASK_DATABASE=
# Opcionales para listado, búsqueda e inicialización de MySQL.
# Ambos son necesarios para habilitar el envío mediante SendGrid.
SENDGRID_API_KEY=
FROM_EMAIL=sender@example.com
